{
  "name": "rittenhouse-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:llms": "tsx scripts/generate-llms.ts",
    "predev": "npm run generate:llms && node scripts/prepare-archive-assets.mjs",
    "dev": "next dev --webpack",
    "prebuild": "npm run generate:llms && node scripts/prepare-archive-assets.mjs && npm run check:truth && npm run check:whats-on && npm run check:images",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:truth": "node scripts/check-site-truth.mjs",
    "check:whats-on": "node scripts/check-whats-on.mjs",
    "check:images": "node scripts/check-property-images.mjs",
    "test:contact": "tsx --test src/lib/contact-security.test.ts src/lib/quote-prefill.test.ts src/app/api/contact/route.test.ts src/proxy.test.ts",
    "test:availability": "tsx --test src/app/api/availability/route.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@vercel/analytics": "^2.0.1",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.3.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
